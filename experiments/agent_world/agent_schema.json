{
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "operation", "arguments_json", "answer_json", "proposals"],
  "properties": {
    "kind": {"type": "string", "enum": ["tool", "answer"]},
    "operation": {"type": "string", "enum": ["query", "get", "list", "history", "select", "facts", "none"]},
    "arguments_json": {"type": "string"},
    "answer_json": {"type": "string"},
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "changes", "expected_version", "reason"],
        "properties": {
          "type": {"type": "string"},
          "id": {"type": "string"},
          "expected_version": {"type": "integer"},
          "reason": {"type": "string"},
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "value_json"],
              "properties": {"field": {"type": "string"}, "value_json": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
